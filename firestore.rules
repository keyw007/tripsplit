rules_version = '2';

// tripsplit 安全規則：貼到 Firebase 主控台 → Firestore Database → 規則（Rules）→ 發布
// - 每個人都是匿名登入，每趟旅行只有成員（memberUids）能看帳、記帳
// - 拿到邀請連結的人可以讀旅行名稱與成員名單，並把自己加入成員
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(tripId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    match /trips/{tripId} {
      // 邀請連結頁面需要讀旅行名稱與成員名單
      allow get: if signedIn();
      // 旅行列表只能查到自己有參加的
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      // 成員可以改旅行設定；非成員只能把自己加進成員名單（加入旅行）
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        )
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /expenses/{expenseId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
